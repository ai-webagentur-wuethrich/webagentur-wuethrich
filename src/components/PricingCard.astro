---
/**
 * Preiskarte für ein Website-Paket (kompakt: Name, Preis, Umfang, Anfrage).
 */
import { ArrowRight } from '@lucide/astro';
import { type Package, chf } from '@/config/pricing';

export interface Props {
  pkg: Package;
  index: number;
}

const { pkg, index } = Astro.props;
---

<article
  class:list={['price-card', 'spot', { 'price-card--featured': pkg.recommended }]}
  aria-labelledby={`paket-${pkg.id}`}
  data-reveal
  data-spotlight
  style={`--reveal-delay: ${index * 90}ms`}
>
  <header class="price-card__head">
    <h3 id={`paket-${pkg.id}`} class="price-card__name">{pkg.name}</h3>
    {pkg.recommended && <p class="price-card__badge mono">Empfohlen</p>}
  </header>

  <p class="price-card__price">
    <span class="price-card__currency mono">CHF</span>
    <span class="price-card__amount">{chf(pkg.price)}</span>
  </p>

  <ul class="check-list price-card__features">
    {pkg.features.map((feature) => <li>{feature}</li>)}
  </ul>

  <a
    href="/#kontakt"
    data-select-package={pkg.id}
    class:list={['btn', pkg.recommended ? 'btn--primary' : 'btn--ghost', 'price-card__cta']}
    aria-label={`Paket ${pkg.name} anfragen`}
  >
    Anfragen <ArrowRight size={16} aria-hidden="true" />
  </a>
</article>

<style>
  .price-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: clamp(1.4rem, 1rem + 1vw, 2rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-bg-raised);
    transition: border-color var(--duration-base) ease;
  }

  .price-card:hover {
    border-color: var(--color-line-strong);
  }

  .price-card--featured {
    border-color: rgb(200 241 105 / 0.55);
    background:
      linear-gradient(180deg, rgb(200 241 105 / 0.08), transparent 45%),
      var(--color-bg-elev);
  }

  .price-card--featured:hover {
    border-color: var(--color-accent);
  }

  .price-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
  }

  .price-card__name {
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }

  .price-card__badge {
    padding: 0.2rem 0.55rem;
    border-radius: 2rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .price-card__price {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .price-card__currency {
    font-size: var(--text-xs);
    color: var(--color-text-soft);
  }

  .price-card__amount {
    font-size: clamp(2.4rem, 2rem + 1.5vw, 3rem);
    font-weight: 560;
    letter-spacing: -0.045em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .price-card__features {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-sm);
    gap: 0.5rem;
  }

  .price-card__cta {
    margin-top: auto;
    width: 100%;
  }
</style>
