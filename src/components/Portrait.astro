---
/**
 * Porträt im Kreis mit animiertem Ring.
 * Foto ablegen unter: src/assets/images/portrait.jpg (oder .jpeg/.png/.webp).
 * Solange kein Foto vorhanden ist, erscheint ein Monogramm.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '@/config/site';

const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/portrait.{jpg,jpeg,png,webp}',
  { eager: true },
);
const photo = Object.values(files)[0]?.default;
const initials = site.owner
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<figure class="portrait">
  <div class="portrait__ring" aria-hidden="true"></div>
  <div class="portrait__frame">
    {
      photo ? (
        <Image
          src={photo}
          alt={`Porträt von ${site.owner}, Inhaber der ${site.name}`}
          widths={[220, 440, 660, 880]}
          sizes="(min-width: 62rem) 13.75rem, 9rem"
          quality={85}
          class="portrait__img"
        />
      ) : (
        <span class="portrait__initials mono" aria-hidden="true">
          {initials}
        </span>
      )
    }
  </div>
  <figcaption class="portrait__caption">
    <span class="portrait__name">{site.owner}</span>
    <span class="portrait__role mono">Inhaber</span>
  </figcaption>
</figure>

<style>
  .portrait {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-lg);
    width: fit-content;
  }

  .portrait__frame,
  .portrait__ring {
    width: clamp(9rem, 6rem + 8vw, 13.75rem);
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .portrait__frame {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    margin: 0.75rem;
    background: var(--color-bg-elev);
    box-shadow: 0 0 0 1px var(--color-line-strong);
  }

  /* Gesicht mittig im Kreis, mit etwas Luft über dem Kopf.
     Weisser Grund = Hintergrundfarbe des Fotos, damit kein Rand sichtbar ist. */
  .portrait__frame:has(:global(.portrait__img)) {
    background: #f8f8fa;
  }

  .portrait__frame :global(.portrait__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
    transform: translate(3.8%, 4%) scale(0.96);
    transform-origin: 50% 0;
  }

  .portrait__initials {
    font-size: 3rem;
    letter-spacing: -0.04em;
    color: var(--color-text-faint);
  }

  /* Gestrichelter Ring mit Akzent-Segment, dreht sich langsam */
  .portrait__ring {
    position: absolute;
    top: 0;
    left: 50%;
    width: calc(clamp(9rem, 6rem + 8vw, 13.75rem) + 1.5rem);
    translate: -50% 0;
    border: 1px dashed var(--color-line-strong);
    background: conic-gradient(from 0deg, var(--color-accent) 0deg 38deg, transparent 38deg 360deg);
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 2px));
    animation: ring-spin 14s linear infinite;
  }

  @keyframes ring-spin {
    to {
      rotate: 360deg;
    }
  }

  /* Auf hellem Hintergrund */
  :global(.surface-paper) .portrait__frame {
    box-shadow: 0 0 0 1px var(--color-paper-line), 0 1.5rem 3rem -1.5rem rgb(var(--bg-rgb) / 0.35);
  }

  :global(.surface-paper) .portrait__ring {
    border-color: var(--color-paper-line);
    background: conic-gradient(from 0deg, var(--color-accent-ink) 0deg 38deg, transparent 38deg 360deg);
  }

  :global(.surface-paper) .portrait__role {
    color: var(--color-ink-soft);
  }

  .portrait__caption {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    text-align: center;
  }

  .portrait__name {
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .portrait__role {
    font-size: var(--text-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
</style>
