---
/**
 * Ablauf eines Projekts – entspricht dem Ablauf in Offerte und AGB.
 */
const steps = [
  {
    title: 'Gespräch & Offerte',
    text: 'Sie erzählen mir, was Sie brauchen. Danach erhalten Sie eine klare Offerte zum Fixpreis.',
  },
  {
    title: 'Start & Unterlagen',
    text: 'Nach Ihrer Unterschrift und der Anzahlung (50 %) liefern Sie Logo, Fotos und Angaben.',
  },
  {
    title: 'Entwurf & Korrekturen',
    text: 'Sie sehen Ihre Website, bevor sie online geht. Zwei Korrekturrunden sind inklusive.',
  },
  {
    title: 'Veröffentlichung',
    text: 'Nach der Schlusszahlung geht Ihre Website online – auf Wunsch mit Hosting und Betreuung.',
  },
];
---

<ol class="steps" role="list">
  {
    steps.map((step, index) => (
      <li class="step" data-reveal style={`--reveal-delay: ${index * 100}ms`}>
        <span class="step__index mono" aria-hidden="true">
          {String(index + 1).padStart(2, '0')}
        </span>
        <h3 class="step__title">{step.title}</h3>
        <p class="step__text">{step.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    gap: 0;
    counter-reset: step;
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-sm);
    padding: var(--space-xl) var(--space-lg) var(--space-xl) 0;
    border-top: 1px solid var(--color-line);
  }

  .step::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 2.5rem;
    height: 1px;
    background: var(--color-accent);
  }

  /* Fortschrittslinie läuft beim Erscheinen Schritt für Schritt durch */
  :global(.js-reveal) .step::before {
    width: 0;
    transition: width 1.4s var(--ease-out) calc(var(--reveal-delay, 0ms) + 300ms);
  }

  :global(.js-reveal) .step:global(.is-visible)::before {
    width: 100%;
  }

  .step__index {
    font-size: var(--text-xs);
    color: var(--color-accent);
  }

  .step__title {
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }

  .step__text {
    color: var(--color-text-soft);
    font-size: var(--text-sm);
    max-width: 30ch;
  }
</style>
