---
/**
 * Landingpage: alle Inhalte auf einer Seite, bewusst knapp gehalten.
 * Bereiche: Hero · Leistungen · Preise · Demo · Über mich · Kontakt
 */
import { Picture } from 'astro:assets';
import {
  ArrowRight,
  ArrowDown,
  ArrowUpRight,
  Phone,
  Mail,
  Plus,
  PenTool,
  Search,
  Gauge,
  LifeBuoy,
} from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LiveMetrics from '@/components/LiveMetrics.astro';
import PricingCard from '@/components/PricingCard.astro';
import DeviceMockup from '@/components/DeviceMockup.astro';
import Portrait from '@/components/Portrait.astro';
import ContactForm from '@/components/ContactForm.astro';
import { site, telHref } from '@/config/site';
import { services } from '@/config/services';
import {
  packages,
  included,
  addons,
  monthlyPlans,
  conditions,
  referenceDiscount,
  chf,
} from '@/config/pricing';
import { websiteSchema, businessSchema, offersSchema } from '@/lib/schema';
import heroImage from '@/assets/images/hero-hoehenlinien.png';
import demoDesktop from '@/assets/images/demo-lindenmatt-desktop.png';
import demoMobile from '@/assets/images/demo-lindenmatt-mobil.png';

const serviceIcons = { design: PenTool, seo: Search, speed: Gauge, care: LifeBuoy };

const ticker = [
  'Astro',
  'Core Web Vitals',
  'AVIF / WebP',
  'Schema.org',
  'Local SEO',
  'HTTPS',
  'DSG-konform',
  'WCAG 2.2',
  'Mobile First',
  'Keine Tracker',
];

const values = ['Sauber programmiert', 'Sicher aufgesetzt', 'Persönlich erreichbar'];
const steps = ['Anfrage', 'Offerte', 'Entwurf', 'Online'];

const { contact } = site;
const schema = [websiteSchema(Astro.site), businessSchema(Astro.site), offersSchema(Astro.site)].filter(
  (entry): entry is NonNullable<typeof entry> => entry !== null,
);
---

<BaseLayout
  title="Webagentur Wüthrich | Webdesign für KMU in Basel & der Schweiz"
  description={site.description}
  schema={schema}
>
  <!-- ================= Hero ================= -->
  <section class="hero" aria-labelledby="hero-title" data-spotlight>
    <div class="hero__media">
      <Picture
        src={heroImage}
        formats={['avif', 'webp']}
        widths={[768, 1280, 1920, 2880]}
        sizes="100vw"
        alt=""
        class="hero__img"
        loading="eager"
        fetchpriority="high"
        fallbackFormat="jpg"
        quality={72}
      />
    </div>
    <div class="hero__light" aria-hidden="true"></div>
    <div class="hero__grid" aria-hidden="true"></div>
    <div class="hero__scan" aria-hidden="true"></div>

    <div class="container hero__inner">
      <div class="hero__content">
        <p class="eyebrow hero__eyebrow">
          <span data-scramble data-scramble-delay="200">Webagentur für Schweizer KMU</span>
        </p>
        <h1 id="hero-title" class="display hero__title">
          Websites, die <em>schnell laden</em> und gefunden werden.
        </h1>
        <p class="lead hero__lead">
          Für KMU in Basel und der ganzen Deutschschweiz: individuell gestaltet, sauber
          programmiert und für Google optimiert – ab CHF 790.
        </p>
        <div class="hero__actions">
          <a href="#kontakt" class="btn btn--lg">
            Offerte anfragen <ArrowRight size={18} aria-hidden="true" />
          </a>
          <a href="#preise" class="btn btn--ghost btn--lg">Preise ansehen</a>
        </div>
        <a href="#preise" class="hero__promo">
          <span class="hero__promo-tag mono">−{referenceDiscount}%</span>
          Referenzrabatt für die ersten Kundinnen und Kunden
          <ArrowRight size={14} aria-hidden="true" />
        </a>
      </div>

      <div class="hero__aside">
        <LiveMetrics />
      </div>

      <a href="#leistungen" class="hero__scroll mono">
        <ArrowDown size={14} aria-hidden="true" /> Mehr erfahren
      </a>
    </div>
  </section>

  <!-- ================= Technik-Laufband ================= -->
  <div class="ticker" role="region" aria-label="Technik und Standards">
    <ul class="ticker__track" role="list">
      {ticker.map((item) => <li>{item}</li>)}
    </ul>
    <ul class="ticker__track" role="list" aria-hidden="true">
      {ticker.map((item) => <li>{item}</li>)}
    </ul>
  </div>

  <!-- ================= Leistungen ================= -->
  <section id="leistungen" class="section surface-paper" aria-labelledby="leistungen-title">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="eyebrow"><span data-scramble>Leistungen</span></p>
          <h2 id="leistungen-title" class="h2 head-gap">
            Alles, was Ihre Website <span class="accent">braucht.</span>
          </h2>
        </div>
        <p class="lead">Ein Ansprechpartner – vom ersten Entwurf bis zur laufenden Betreuung.</p>
      </div>

      <ul class="services" role="list">
        {
          services.map((service, index) => {
            const Icon = serviceIcons[service.icon];
            return (
              <li class="service" data-reveal style={`--reveal-delay: ${index * 80}ms`}>
                <span class="service__icon" aria-hidden="true">
                  <Icon size={22} />
                </span>
                <h3 class="service__title">{service.title}</h3>
                <p class="service__text">{service.text}</p>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <!-- ================= Preise ================= -->
  <section id="preise" class="section" aria-labelledby="preise-title">
    <div class="container">
      <div class="section-head section-head--split" data-reveal>
        <div>
          <p class="eyebrow"><span data-scramble>Preise</span></p>
          <h2 id="preise-title" class="h2 head-gap">Fixpreise statt Stundenrapport.</h2>
        </div>
        <p class="lead">Einmalig, in CHF, nicht MWST-pflichtig.</p>
      </div>

      <div class="promo spot" data-spotlight data-reveal>
        <span class="promo__badge" aria-hidden="true">−{referenceDiscount}%</span>
        <div class="promo__text">
          <p class="promo__title">
            <span class="visually-hidden">{referenceDiscount} % </span>Referenzrabatt für die ersten
            Kundinnen und Kunden
          </p>
          <p class="promo__sub">
            Auf alle Website-Pakete – im Gegenzug darf ich Ihre Website als Referenz zeigen. Nur für
            wenige Projekte.
          </p>
        </div>
      </div>

      <div class="price-grid" role="region" aria-label="Website-Pakete" tabindex="0" data-price-scroller>
        {packages.map((pkg, index) => <PricingCard pkg={pkg} index={index} />)}
      </div>
      <p class="swipe-hint mono" aria-hidden="true">← Wischen für alle Pakete →</p>

      <div class="included" data-reveal>
        <p class="included__label mono">Immer inklusive</p>
        <ul class="included__list" role="list">
          {included.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="plans" data-reveal>
        <p class="included__label mono">Nach dem Start, optional</p>
        <div class="plans__grid">
          {
            monthlyPlans.map((plan) => (
              <article
                class:list={['plan', { 'plan--featured': plan.recommended }]}
                aria-labelledby={`plan-${plan.id}`}
              >
                <h3 id={`plan-${plan.id}`} class="plan__name">
                  {plan.name}
                  {plan.recommended && <span class="plan__badge mono">Empfohlen</span>}
                </h3>
                <p class="plan__price">
                  <span class="plan__amount">CHF {plan.monthly}</span>
                  <span class="plan__unit">/ Monat</span>
                </p>
                <p class="plan__desc">{plan.description}</p>
              </article>
            ))
          }
        </div>
      </div>

      <details class="more" data-reveal>
        <summary>
          <span>Zusatzfunktionen & Konditionen</span>
          <Plus size={18} aria-hidden="true" class="more__icon" />
        </summary>
        <div class="more__body">
          <div>
            <h3 class="more__title">Zusatzfunktionen</h3>
            <table class="price-table">
              <caption class="visually-hidden">Zusatzfunktionen und Preise in CHF</caption>
              <tbody>
                {
                  addons.map((addon) => (
                    <tr>
                      <th scope="row">{addon.name}</th>
                      <td class="num mono">CHF {addon.price}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <p class="more__note">
              Hosting jährlich: CHF {chf(monthlyPlans[0].yearly)}, Betreuung jährlich: CHF
              {' '}{chf(monthlyPlans[1].yearly)} (je 1 Monat gratis).
            </p>
          </div>
          <div>
            <h3 class="more__title">Konditionen</h3>
            <dl class="conditions">
              {
                conditions.map((item) => (
                  <div class="condition">
                    <dt>{item.title}</dt>
                    <dd>{item.text}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="more__note">
              Es gelten die <a href="/agb/">Allgemeinen Geschäftsbedingungen</a>.
            </p>
          </div>
        </div>
      </details>
    </div>
  </section>

  <!-- ================= Demo ================= -->
  <section id="demo" class="section section--raised demo" aria-labelledby="demo-title">
    <div class="container demo__inner">
      <div class="demo__text" data-reveal>
        <p class="eyebrow"><span data-scramble>Demo-Beispiel</span></p>
        <h2 id="demo-title" class="h2">So kann Ihre Website aussehen.</h2>
        <p class="lead">
          Die Schreinerei ist erfunden – die Website ist echt: eigenes Design, schnell und für das
          Handy gemacht.
        </p>
        <a
          href="https://demo.webagentur-wuethrich.com"
          class="btn btn--ghost"
          target="_blank"
          rel="noopener"
        >
          Demo öffnen <ArrowUpRight size={16} aria-hidden="true" />
          <span class="visually-hidden">(öffnet in neuem Tab)</span>
        </a>
      </div>

      <div data-reveal style="--reveal-delay: 120ms">
        <DeviceMockup
          desktop={demoDesktop}
          mobile={demoMobile}
          alt="Startseite der Demo-Website einer fiktiven Schreinerei mit grossem Werkstattbild und der Überschrift «Holz, das bleibt. Gebaut in Burgdorf.»"
          urlLabel="demo.webagentur-wuethrich.com"
          sizes="(min-width: 78rem) 44rem, (min-width: 62rem) 55vw, 92vw"
          label="Demo · fiktive Firma"
        />
      </div>
    </div>
  </section>

  <!-- ================= Über mich ================= -->
  <section id="ueber-mich" class="section surface-paper" aria-labelledby="ueber-title">
    <div class="container about">
      <div class="about__portrait" data-reveal>
        <Portrait />
      </div>
      <div class="about__text" data-reveal style="--reveal-delay: 100ms">
        <p class="eyebrow"><span data-scramble>Über mich</span></p>
        <h2 id="ueber-title" class="h2">
          Agentur-Qualität. <span class="accent">Ohne Agentur-Preise.</span>
        </h2>
        <p class="lead">
          Professionell umgesetzt, mit direktem Ansprechpartner und klarem Fixpreis. Jede Website
          wird sauber und sicher aufgebaut, lädt schnell und wird bei Google gefunden.
        </p>
        <ul class="values" role="list">
          {values.map((value) => <li class="mono">{value}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= Kontakt ================= -->
  <section id="kontakt" class="section contact-section" aria-labelledby="kontakt-title">
    <div class="container contact">
      <div class="contact__info" data-reveal>
        <p class="eyebrow"><span data-scramble>Kontakt</span></p>
        <h2 id="kontakt-title" class="h2">
          Reden wir über <span class="accent">Ihre Website.</span>
        </h2>
        <p class="lead">Sie erhalten eine unverbindliche Offerte zum Fixpreis.</p>

        <ol class="steps mono" role="list" aria-label="Ablauf">
          {
            steps.map((step, index) => (
              <li>
                <span aria-hidden="true">{index + 1}</span>
                {step}
              </li>
            ))
          }
        </ol>

        <div class="contact__direct">
          <a href={telHref} class="contact__link">
            <Phone size={18} aria-hidden="true" />
            {contact.phone}
          </a>
          {
            contact.email && (
              <a href={`mailto:${contact.email}`} class="contact__link">
                <Mail size={18} aria-hidden="true" />
                {contact.email}
              </a>
            )
          }
        </div>
      </div>

      <div class="contact__form spot" data-spotlight data-reveal style="--reveal-delay: 120ms">
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Auf dem Handy: Paket-Karussell beim empfohlenen Paket starten.
  const scroller = document.querySelector<HTMLElement>('[data-price-scroller]');
  const featured = scroller?.querySelector<HTMLElement>('.price-card--featured');
  if (scroller && featured && scroller.scrollWidth > scroller.clientWidth) {
    scroller.scrollLeft = featured.offsetLeft - (scroller.clientWidth - featured.offsetWidth) / 2;
  }
</script>

<style>
  .head-gap {
    margin-top: var(--space-md);
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: var(--color-bg);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -3;
  }

  .hero__media :global(picture) {
    display: block;
    height: 100%;
  }

  .hero__media :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% 45%;
    animation: hero-in 1600ms var(--ease-out) both;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Lichtkegel folgt dem Mauszeiger und lässt die Höhenlinien aufleuchten */
  .hero__light {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: radial-gradient(
      var(--spot-size, 26rem) circle at var(--mx, 70%) var(--my, 40%),
      rgb(var(--accent-rgb) / var(--spot-alpha, 0.2)),
      transparent 70%
    );
    mix-blend-mode: color-dodge;
    opacity: 0;
    transition: opacity 600ms ease;
    pointer-events: none;
  }

  .hero:global(.is-lit) .hero__light {
    opacity: 1;
  }

  /* Einmaliger Scan-Strahl beim Laden */
  .hero__scan {
    position: absolute;
    inset: 0 auto 0 0;
    z-index: -1;
    width: 30%;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(var(--accent-rgb) / 0.07) 85%,
      rgb(var(--accent-rgb) / 0.45) 99.5%,
      transparent
    );
    transform: translateX(-100%);
    animation: hero-scan 2.4s cubic-bezier(0.6, 0, 0.3, 1) 0.5s both;
    pointer-events: none;
  }

  @keyframes hero-scan {
    0% {
      transform: translateX(-100%);
      opacity: 1;
    }
    85% {
      opacity: 1;
    }
    100% {
      transform: translateX(380%);
      opacity: 0;
    }
  }

  /* Dezenter Parallax beim Scrollen (nur moderne Browser, nur ohne «weniger Bewegung») */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero__media {
        animation: hero-parallax linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }

      @keyframes hero-parallax {
        to {
          transform: translateY(14%);
        }
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scan {
      display: none;
    }
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to right, rgb(255 255 255 / 0.04) 1px, transparent 1px) 0 0 / 25% 100%,
      linear-gradient(to bottom, rgb(var(--bg-rgb) / 0) 20%, rgb(var(--bg-rgb) / 0.55) 60%, rgb(var(--bg-rgb) / 0.8));
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-xl);
    padding-top: calc(var(--header-height) + var(--space-xl));
    padding-bottom: var(--space-2xl);
  }

  .hero__content {
    align-self: center;
    display: grid;
    gap: var(--space-lg);
    max-width: 52rem;
  }

  .hero__eyebrow {
    animation: fade-in 800ms ease both 200ms;
  }

  .hero__title {
    max-width: 14ch;
    animation: fade-up 1100ms var(--ease-out) both 250ms;
  }

  .hero__title em {
    position: relative;
    font-style: normal;
    color: var(--color-accent);
  }

  /* Unterstrich, der sich nach dem Laden einzeichnet */
  .hero__title em::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.02em;
    height: 0.06em;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    animation: underline 900ms var(--ease-out) 1300ms forwards;
  }

  @keyframes underline {
    to {
      transform: scaleX(1);
    }
  }

  .hero__lead {
    color: #c9d1da;
    animation: fade-up 1100ms var(--ease-out) both 400ms;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
    animation: fade-up 1100ms var(--ease-out) both 520ms;
  }

  /* Live-Messung nur auf grossen Bildschirmen – auf dem Handy wäre sie zu viel */
  .hero__aside,
  .hero__scroll {
    display: none;
  }

  @media (max-width: 29.99rem) {
    .hero__actions .btn {
      width: 100%;
    }
  }

  @media (max-width: 61.99rem) {
    .hero__media :global(.hero__img) {
      object-position: 82% 40%;
    }

    /* Kleinerer Lichtkegel für den Finger */
    .hero__light {
      --spot-size: 15rem;
      --spot-alpha: 0.32;
    }

    /* Handy: Text unten, Höhenlinien darüber sichtbar */
    .hero__content {
      align-self: end;
    }
  }

  @media (min-width: 62rem) {
    .hero__grid {
      background:
        linear-gradient(to right, rgb(255 255 255 / 0.04) 1px, transparent 1px) 0 0 / 25% 100%,
        linear-gradient(to top, rgb(var(--bg-rgb) / 0.9), transparent 35%),
        linear-gradient(to right, rgb(var(--bg-rgb) / 0.6), transparent 70%);
    }

    .hero__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: 1fr auto;
    }

    .hero__content {
      grid-column: 1;
      grid-row: 1;
    }

    .hero__aside {
      display: block;
      grid-column: 2;
      grid-row: 1;
      align-self: end;
      width: 18rem;
      animation: fade-up 1100ms var(--ease-out) both 700ms;
    }

    .hero__scroll {
      grid-column: 1 / -1;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      justify-self: start;
      font-size: var(--text-2xs);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--color-text-faint);
      transition: color var(--duration-fast) ease;
    }

    .hero__scroll:hover {
      color: var(--color-accent);
    }

    .hero__scroll :global(svg) {
      animation: nudge 2s ease-in-out infinite;
    }

    @keyframes nudge {
      50% {
        transform: translateY(3px);
      }
    }
  }

  /* ---------- Laufband ---------- */
  .ticker {
    display: flex;
    overflow: hidden;
    border-block: 1px solid var(--color-line);
    background: var(--color-bg-raised);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .ticker__track {
    display: flex;
    flex-shrink: 0;
    gap: 3rem;
    padding: 0.9rem 1.5rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-soft);
    white-space: nowrap;
    animation: ticker 38s linear infinite;
  }

  .ticker__track li {
    display: inline-flex;
    align-items: center;
    gap: 3rem;
  }

  .ticker__track li::after {
    content: '';
    width: 0.35rem;
    height: 0.35rem;
    background: var(--color-accent);
  }

  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }

  @keyframes ticker {
    to {
      transform: translateX(-100%);
    }
  }

  /* ---------- Leistungen (hell) ---------- */
  .services {
    display: grid;
    gap: var(--space-lg) var(--space-xl);
  }

  @media (min-width: 40rem) {
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 72rem) {
    .services {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .service {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.35rem var(--space-md);
    align-content: start;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-paper-line);
  }

  .service__icon {
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    background: var(--color-ink);
    color: var(--color-accent);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .service:hover .service__icon {
    transform: rotate(-6deg) scale(1.05);
  }

  .service__title {
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }

  .service__text {
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
  }

  @media (min-width: 72rem) {
    .service {
      grid-template-columns: 1fr;
    }

    .service__icon {
      grid-row: auto;
      margin-bottom: var(--space-sm);
    }
  }

  /* ---------- Preise ---------- */
  /* Referenzrabatt – gut sichtbar über den Paketen */
  .promo {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
    padding: var(--space-lg) clamp(1.25rem, 1rem + 1vw, 2rem);
    border: 1px solid rgb(var(--accent-rgb) / 0.5);
    border-radius: var(--radius-md);
    background:
      linear-gradient(90deg, rgb(var(--accent-rgb) / 0.14), rgb(var(--accent-rgb) / 0.03) 70%),
