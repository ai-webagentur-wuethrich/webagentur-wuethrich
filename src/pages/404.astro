---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Seite nicht gefunden" description="Diese Seite existiert nicht." noindex>
  <section class="section not-found grid-bg">
    <div class="container not-found__inner">
      <p class="not-found__code mono" aria-hidden="true">404</p>
      <p class="eyebrow">Seite nicht gefunden</p>
      <h1 class="not-found__title">Hier führt <em>kein Weg</em> weiter.</h1>
      <p class="lead">
        Die gesuchte Seite wurde verschoben oder existiert nicht. Über die Startseite finden Sie
        schnell wieder zurück.
      </p>
      <div class="not-found__actions">
        <a href="/" class="btn">Zur Startseite <ArrowRight size={18} aria-hidden="true" /></a>
        <a href="/#kontakt" class="btn btn--ghost">Kontakt</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 90vh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--header-height) + var(--space-2xl));
  }

  .not-found__inner {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }

  .not-found__code {
    font-size: clamp(4rem, 2rem + 10vw, 10rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-line-strong);
  }

  .not-found__title {
    max-width: 16ch;
    font-size: clamp(2.2rem, 1.6rem + 3vw, 4rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
  }

  .not-found__title em {
    font-style: normal;
    color: var(--color-accent);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>
