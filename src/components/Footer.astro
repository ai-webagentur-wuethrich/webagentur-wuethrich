---
import { ArrowUpRight } from '@lucide/astro';
import { site, telHref } from '@/config/site';
import Logo from '@/components/Logo.astro';

const { contact } = site;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" class="site-footer__logo" aria-label={`${site.name} – zur Startseite`}>
          <Logo />
        </a>
        <p class="site-footer__claim">
          Schnelle, sichere und für Google optimierte Websites für Schweizer KMU.
        </p>
      </div>

      <div class="site-footer__cols">
        <div>
          <h2 class="site-footer__title mono">Kontakt</h2>
          <address class="site-footer__address">
            {site.name}<br />
            {site.owner}<br />
            {contact.street}<br />
            {contact.postalCode} {contact.city}
          </address>
          <ul role="list" class="site-footer__list">
            <li>
              <a href={telHref}>{contact.phone}</a>
            </li>
            {
              contact.email && (
                <li>
                  <a href={`mailto:${contact.email}`}>{contact.email}</a>
                </li>
              )
            }
          </ul>
        </div>

        <div>
          <h2 class="site-footer__title mono">Rechtliches</h2>
          <ul role="list" class="site-footer__list">
            {
              site.legalNav.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="mono">© {year} {site.name}</p>
      <p class="mono site-footer__meta">
        <a href="#inhalt" class="site-footer__top-link">
          Nach oben <ArrowUpRight size={14} aria-hidden="true" />
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-line);
    background: var(--color-bg);
    padding-top: var(--space-2xl);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .site-footer__top {
    display: grid;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
  }

  @media (min-width: 62rem) {
    .site-footer__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    }
  }

  .site-footer__logo {
    display: inline-block;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-footer__claim {
    margin-top: var(--space-lg);
    max-width: 22rem;
  }

  .site-footer__cols {
    display: grid;
    gap: var(--space-xl);
  }

  .site-footer__cols {
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
  }

  .site-footer__title {
    margin-bottom: var(--space-md);
    font-size: var(--text-2xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .site-footer__address {
    margin-bottom: var(--space-sm);
    font-style: normal;
  }

  .site-footer__list {
    display: grid;
    gap: 0.15rem;
  }

  .site-footer__list a {
    display: inline-block;
    padding-block: 0.3rem;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .site-footer__list a:hover {
    color: var(--color-accent);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-2xs);
    color: var(--color-text-faint);
  }

  .site-footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }

  .site-footer__top-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    text-decoration: none;
    color: var(--color-text-soft);
  }

  .site-footer__top-link:hover {
    color: var(--color-accent);
  }
</style>
