---
/**
 * Screenshot einer Website im Browserfenster, ergänzt um die Smartphone-Ansicht.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  desktop: ImageMetadata;
  mobile: ImageMetadata;
  alt: string;
  /** Leer lassen, wenn das Handybild nur dekorativ ist. */
  mobileAlt?: string;
  urlLabel: string;
  sizes: string;
  eager?: boolean;
  label?: string;
}

const { desktop, mobile, alt, mobileAlt = '', urlLabel, sizes, eager = false, label } = Astro.props;
---

<div class="mockup">
  <figure class="mockup__browser">
    <div class="mockup__bar" aria-hidden="true">
      <span></span><span></span><span></span>
      <p class="mockup__url mono">{urlLabel}</p>
    </div>
    <Image
      src={desktop}
      alt={alt}
      widths={[640, 960, 1440, 2160]}
      sizes={sizes}
      quality={76}
      loading={eager ? 'eager' : 'lazy'}
    />
  </figure>
  <figure class="mockup__phone" aria-hidden={mobileAlt ? undefined : 'true'}>
    <Image src={mobile} alt={mobileAlt} widths={[240, 480]} sizes="11rem" quality={76} />
  </figure>
  {label && <p class="mockup__label mono">{label}</p>}
</div>

<style>
  .mockup {
    position: relative;
    padding-bottom: 2.5rem;
    padding-right: 1.25rem;
  }

  .mockup__browser {
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-elev);
    box-shadow: 0 2rem 4rem -1.5rem rgb(0 0 0 / 0.7);
  }

  .mockup__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--color-line);
  }

  .mockup__bar span {
    flex-shrink: 0;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--color-line-strong);
  }

  .mockup__url {
    margin-left: 0.75rem;
    font-size: 0.6875rem;
    color: var(--color-text-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mockup__phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: clamp(6.5rem, 24%, 11rem);
    overflow: hidden;
    border: 5px solid #2d3139;
    border-radius: 1.2rem;
    background: #2d3139;
    box-shadow: 0 1.5rem 3rem -1rem rgb(0 0 0 / 0.8);
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .mockup:hover .mockup__phone {
    transform: translateY(-0.5rem);
  }

  .mockup__phone :global(img) {
    border-radius: 0.8rem;
  }

  .mockup__label {
    position: absolute;
    left: 0;
    bottom: 0.4rem;
    font-size: var(--text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
</style>
