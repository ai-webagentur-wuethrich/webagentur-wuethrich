---
/**
 * Kopfzeile: fixiert, anfangs transparent, beim Scrollen mit dezentem
 * Hintergrund. Unter 62rem Breite: Menü-Knopf mit Vollbild-Navigation.
 */
import { Menu, X, Phone, ArrowRight } from '@lucide/astro';
import { site, telHref } from '@/config/site';
import Logo from '@/components/Logo.astro';

---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label={`${site.name} – zur Startseite`}>
      <Logo />
    </a>

    <nav class="site-nav" id="hauptnavigation" aria-label="Hauptnavigation" data-nav>
      <ul class="site-nav__list" role="list">
        {
          site.nav.map((item, index) => (
            <li style={`--i: ${index}`}>
              <a href={item.href} class="site-nav__link" data-spy={item.href.split('#')[1]}>
                <span class="site-nav__index mono" aria-hidden="true">
                  0{index + 1}
                </span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="site-nav__actions">
        <a class="site-nav__phone" href={telHref}>
          <Phone size={16} aria-hidden="true" />
          <span>{site.contact.phone}</span>
        </a>
        <a href="/#kontakt" class="btn site-nav__cta">
          Kontakt <ArrowRight size={16} aria-hidden="true" />
        </a>
      </div>
    </nav>

    <button
      type="button"
      class="nav-toggle"
      aria-controls="hauptnavigation"
      aria-expanded="false"
      data-nav-toggle
    >
      <span class="visually-hidden" data-nav-label>Menü öffnen</span>
      <Menu class="nav-toggle__icon nav-toggle__icon--open" size={24} aria-hidden="true" />
      <X class="nav-toggle__icon nav-toggle__icon--close" size={24} aria-hidden="true" />
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const label = document.querySelector<HTMLElement>('[data-nav-label]');
  const desktop = window.matchMedia('(min-width: 62rem)');

  const setOpen = (open: boolean) => {
    if (!toggle || !header) return;
    toggle.setAttribute('aria-expanded', String(open));
    header.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('nav-locked', open);
    if (label) label.textContent = open ? 'Menü schliessen' : 'Menü öffnen';
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  // Menü schliessen bei Linkklick, Escape-Taste oder Wechsel auf Desktop-Breite.
  nav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && header?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
  desktop.addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });

  // Scroll-Spy: aktiven Bereich der Landingpage in der Navigation markieren.
  const spyLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy]'));
  const sections = spyLinks
    .map((link) => document.getElementById(link.dataset.spy ?? ''))
    .filter((el): el is HTMLElement => el !== null);
  if (sections.length && 'IntersectionObserver' in window) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          spyLinks.forEach((link) => link.classList.toggle('is-active', link.dataset.spy === entry.target.id));
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => spy.observe(section));
  }

  // Hintergrund einblenden, sobald gescrollt wird.
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--duration-base) ease,
      border-color var(--duration-base) ease,
      backdrop-filter var(--duration-base) ease;
  }

  .site-header.is-scrolled,
  .site-header.is-open {
    background: rgb(var(--bg-rgb) / 0.82);
    border-bottom-color: var(--color-line);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  /* Ohne backdrop-filter, sonst wäre die fixierte Navigation im Header «gefangen». */
  .site-header.is-open {
    background: var(--color-bg);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    height: var(--header-height);
  }

  .site-header__brand {
    position: relative;
    z-index: 2;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  /* ---------- Mobile Navigation (Vollbild) ---------- */
  .site-nav {
    position: fixed;
    inset: var(--header-height) 0 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-xl);
    padding: var(--space-xl) var(--gutter) calc(var(--space-xl) + env(safe-area-inset-bottom));
    background: var(--color-bg);
    overflow-y: auto;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity var(--duration-base) ease,
      visibility 0s linear var(--duration-base);
  }

  .is-open .site-nav {
    visibility: visible;
    opacity: 1;
    transition:
      opacity var(--duration-base) ease,
      visibility 0s;
  }

  .site-nav__list {
    display: grid;
    border-top: 1px solid var(--color-line);
  }

  .site-nav__list li {
    border-bottom: 1px solid var(--color-line);
  }

  .is-open .site-nav__list li {
    animation: fade-up 600ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 60ms + 80ms);
  }

  .site-nav__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.1rem 0;
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.2rem);
    font-weight: 540;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .site-nav__index {
    font-size: var(--text-2xs);
    color: var(--color-text-faint);
    letter-spacing: 0.05em;
  }

  .site-nav__link.is-active {
    color: var(--color-accent);
  }

  .site-nav__actions {
    display: grid;
    gap: var(--space-md);
  }

  .site-nav__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-text-soft);
    transition: color var(--duration-fast) ease;
  }

  .site-nav__phone:hover {
    color: var(--color-text);
  }

  .site-nav__cta {
    min-height: 3.25rem;
  }

  .nav-toggle {
    position: relative;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.875rem;
    height: 2.875rem;
    margin-right: -0.5rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
  }

  .nav-toggle__icon {
    grid-area: 1 / 1;
    transition:
      opacity var(--duration-fast) ease,
      transform var(--duration-base) var(--ease-out);
  }

  .nav-toggle__icon--close {
    opacity: 0;
    transform: rotate(-90deg);
  }

  .is-open .nav-toggle__icon--open {
    opacity: 0;
    transform: rotate(90deg);
  }

  .is-open .nav-toggle__icon--close {
    opacity: 1;
    transform: none;
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 62rem) {
    .nav-toggle {
      display: none;
    }

    .site-nav {
      position: static;
      flex-direction: row;
      align-items: center;
      justify-content: flex-end;
      gap: var(--space-lg);
      padding: 0;
      background: none;
      overflow: visible;
      visibility: visible;
      opacity: 1;
      transition: none;
    }

    .site-nav__list {
      display: flex;
      gap: 0.25rem;
      border: 0;
    }

    .site-nav__list li {
      border: 0;
    }

    .site-nav__link {
      position: relative;
      padding: 0.5rem 0.75rem;
      font-size: var(--text-sm);
      font-weight: 500;
      letter-spacing: -0.005em;
      color: var(--color-text-soft);
      transition: color var(--duration-fast) ease;
    }

    .site-nav__link:hover,
    .site-nav__link.is-active {
      color: var(--color-text);
    }

    .site-nav__link::after {
      content: '';
      position: absolute;
      left: 0.75rem;
      right: 0.75rem;
      bottom: 0.2rem;
      height: 1px;
      background: var(--color-accent);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--duration-base) var(--ease-out);
    }

    .site-nav__link:hover::after,
    .site-nav__link.is-active::after {
      transform: scaleX(1);
    }

    .site-nav__index {
      display: none;
    }

    .site-nav__actions {
      display: flex;
      align-items: center;
      gap: var(--space-lg);
      padding-left: var(--space-lg);
      border-left: 1px solid var(--color-line);
    }

    .site-nav__cta {
      min-height: 2.5rem;
      padding: 0.5rem 1rem;
    }
  }

  @media (min-width: 62rem) and (max-width: 74.99rem) {
    .site-nav__phone span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
